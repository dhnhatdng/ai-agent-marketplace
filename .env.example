# ═══════════════════════════════════════════
# AI AGENT MARKETPLACE — Environment Variables
# Copy file này thành .env trong mỗi thư mục
# ═══════════════════════════════════════════

# ── CONTRACTS (.env trong /contracts) ──────
PRIVATE_KEY=your_metamask_private_key_here

# ── BACKEND (.env trong /backend) ──────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# Arc Network
ARC_RPC_URL=https://rpc.testnet.arc.network
DEPLOYER_PRIVATE_KEY=your_metamask_private_key_here
AGENT_ESCROW_ADDRESS=paste_deployed_address_here

# Circle API — lấy tại console.circle.com
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_32_byte_hex_entity_secret_here
CIRCLE_PUBLIC_KEY=paste_circle_rsa_public_key_here

# OpenAI — lấy tại platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Platform settings
PLATFORM_FEE_PERCENT=5

# ── FRONTEND (.env trong /frontend) ────────
VITE_API_URL=http://localhost:4000
VITE_WALLETCONNECT_PROJECT_ID=get_from_cloud.walletconnect.com
VITE_ESCROW_ADDRESS=paste_deployed_address_here
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
